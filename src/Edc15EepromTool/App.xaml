<Application x:Class="Edc15EepromTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Edc15EepromTool.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- replaced at run time by ThemeManager, which keeps it in the first place -->
                <ResourceDictionary Source="Themes/Colors.Dark.xaml"/>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <c:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <c:HasValueToVisibilityConverter x:Key="HasValueToVis"/>
            <c:HasValueConverter x:Key="HasValue"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
