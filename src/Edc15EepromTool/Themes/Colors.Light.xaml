<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- light palette: used when Windows is set to the light app mode; same keys as Colors.Dark.xaml -->
    <Color x:Key="BgColor">#EEF2F7</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceRaisedColor">#F3F6FA</Color>
    <Color x:Key="SurfaceHoverColor">#E7EDF4</Color>
    <Color x:Key="BorderColor">#E1E7EF</Color>
    <Color x:Key="BorderStrongColor">#CBD5E1</Color>
    <Color x:Key="TextColor">#0F172A</Color>
    <Color x:Key="TextMutedColor">#4B5A70</Color>
    <Color x:Key="TextFaintColor">#8A97AA</Color>
    <Color x:Key="AccentColor">#0891B2</Color>
    <Color x:Key="AccentHoverColor">#0E7490</Color>
    <Color x:Key="AccentPressedColor">#155E75</Color>
    <Color x:Key="OnAccentColor">#FFFFFF</Color>
    <Color x:Key="SuccessColor">#059669</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="WarningColor">#CA8A04</Color>
    <Color x:Key="LoginCodeColor">#4F46E5</Color>
    <Color x:Key="ImmoColor">#9333EA</Color>
    <Color x:Key="OdometerColor">#059669</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#B91C1C"/>
    <SolidColorBrush x:Key="OnDangerBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="LoginCodeBrush" Color="{StaticResource LoginCodeColor}"/>
    <SolidColorBrush x:Key="ImmoBrush" Color="{StaticResource ImmoColor}"/>
    <SolidColorBrush x:Key="OdometerBrush" Color="{StaticResource OdometerColor}"/>

    <SolidColorBrush x:Key="AccentTintBrush" Color="{StaticResource AccentColor}" Opacity="0.10"/>
    <SolidColorBrush x:Key="SuccessTintBrush" Color="{StaticResource SuccessColor}" Opacity="0.10"/>
    <SolidColorBrush x:Key="DangerTintBrush" Color="{StaticResource DangerColor}" Opacity="0.08"/>
    <SolidColorBrush x:Key="WarningTintBrush" Color="{StaticResource WarningColor}" Opacity="0.12"/>
    <SolidColorBrush x:Key="LoginCodeTintBrush" Color="{StaticResource LoginCodeColor}" Opacity="0.10"/>
    <SolidColorBrush x:Key="ImmoTintBrush" Color="{StaticResource ImmoColor}" Opacity="0.10"/>
    <SolidColorBrush x:Key="OdometerTintBrush" Color="{StaticResource OdometerColor}" Opacity="0.10"/>

    <SolidColorBrush x:Key="SwitchTrackOffBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="SwitchThumbBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SwitchThumbOnBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#0F172A" Opacity="0.40"/>
    <SolidColorBrush x:Key="DropHintBrush" Color="#EEF2F7" Opacity="0.92"/>
    <Color x:Key="ShadowColor">#64748B</Color>

</ResourceDictionary>
