<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- dark palette: used when Windows is set to the dark app mode -->
    <Color x:Key="BgColor">#0B1220</Color>
    <Color x:Key="SurfaceColor">#111A2E</Color>
    <Color x:Key="SurfaceRaisedColor">#17223B</Color>
    <Color x:Key="SurfaceHoverColor">#1E2B49</Color>
    <Color x:Key="BorderColor">#1F2C47</Color>
    <Color x:Key="BorderStrongColor">#2C3C5E</Color>
    <Color x:Key="TextColor">#E6EDF7</Color>
    <Color x:Key="TextMutedColor">#97A6BD</Color>
    <Color x:Key="TextFaintColor">#5B6B85</Color>
    <Color x:Key="AccentColor">#22D3EE</Color>
    <Color x:Key="AccentHoverColor">#67E8F9</Color>
    <Color x:Key="AccentPressedColor">#06B6D4</Color>
    <Color x:Key="OnAccentColor">#03202A</Color>
    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="DangerColor">#F87171</Color>
    <Color x:Key="WarningColor">#FBBF24</Color>
    <Color x:Key="LoginCodeColor">#818CF8</Color>
    <Color x:Key="ImmoColor">#C084FC</Color>
    <Color x:Key="OdometerColor">#34D399</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="#3B4F78"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#FCA5A5"/>
    <SolidColorBrush x:Key="OnDangerBrush" Color="#2A0707"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="LoginCodeBrush" Color="{StaticResource LoginCodeColor}"/>
    <SolidColorBrush x:Key="ImmoBrush" Color="{StaticResource ImmoColor}"/>
    <SolidColorBrush x:Key="OdometerBrush" Color="{StaticResource OdometerColor}"/>

    <SolidColorBrush x:Key="AccentTintBrush" Color="{StaticResource AccentColor}" Opacity="0.12"/>
    <SolidColorBrush x:Key="SuccessTintBrush" Color="{StaticResource SuccessColor}" Opacity="0.14"/>
    <SolidColorBrush x:Key="DangerTintBrush" Color="{StaticResource DangerColor}" Opacity="0.14"/>
    <SolidColorBrush x:Key="WarningTintBrush" Color="{StaticResource WarningColor}" Opacity="0.14"/>
    <SolidColorBrush x:Key="LoginCodeTintBrush" Color="{StaticResource LoginCodeColor}" Opacity="0.22"/>
    <SolidColorBrush x:Key="ImmoTintBrush" Color="{StaticResource ImmoColor}" Opacity="0.22"/>
    <SolidColorBrush x:Key="OdometerTintBrush" Color="{StaticResource OdometerColor}" Opacity="0.22"/>

    <SolidColorBrush x:Key="SwitchTrackOffBrush" Color="#334360"/>
    <SolidColorBrush x:Key="SwitchThumbBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SwitchThumbOnBrush" Color="#06281C"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#05080F" Opacity="0.72"/>
    <SolidColorBrush x:Key="DropHintBrush" Color="#0B1220" Opacity="0.9"/>
    <Color x:Key="ShadowColor">#000000</Color>

</ResourceDictionary>
